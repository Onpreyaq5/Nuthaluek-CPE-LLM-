# infra
DATABASE_URL=postgresql+psycopg://rmutt:change_me_please@localhost:5432/rmutt
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# entrypoint.sh: ตั้ง true เฉพาะ dev/demo เท่านั้น ห้ามใช้ใน production จริง
SEED_DEMO=false

# auth / บัญชีเดโม (PLAN.md หัวข้อ 5)
DEMO_USERNAME=admin
DEMO_PASSWORD=admin1234
DEMO_STUDENT_ID=6500000000
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# adapter (PLAN.md หัวข้อ 3.2) — mock | inprocess | http
ADAPTER_04=mock
ADAPTER_05=mock
ADAPTER_06=mock
ADAPTER_07=mock
ADAPTER_08=mock
# 03 ใช้ http เสมอ — URL จริงตาม docker-compose.yml ที่ root (env AI_ROUTER_URL) รับ ROUTER_URL เป็นชื่อสำรองด้วย
AI_ROUTER_URL=http://ai_router:8100

# URL ของโมดูล 04-08 เมื่อ ADAPTER_xx=http — PLACEHOLDER ยังไม่มีสัญญาจริงจากทีม (ดู PROGRESS.md)
COURSE_CATALOG_URL=http://course_catalog:8400
STUDENT_DATA_URL=http://student_data:8500
PLAN_ENGINE_URL=http://plan_engine:8600
EXPLAINER_URL=http://explainer:8700
LOG_SINK_URL=http://log_sink:8800

# inprocess loader (ADAPTER_04/05=inprocess) — ชื่อโฟลเดอร์โมดูลข้างๆ 02_api_backend
# MODULE_04_DIR เป็น PLACEHOLDER เพราะยังไม่ทราบชื่อโฟลเดอร์จริงของโมดูล 04
MODULES_ROOT=..
MODULE_04_DIR=04_course_data
MODULE_05_DIR=05_data_integration

# timeout / retry ต่อประเภทคำขอ (PLAN.md ตาราง 3.3) หน่วยวินาที
TIMEOUT_READ_SECONDS=5
RETRY_READ=1
TIMEOUT_VALIDATE_SECONDS=5
RETRY_VALIDATE=1
TIMEOUT_AUTO_SECONDS=15
RETRY_AUTO=0
TIMEOUT_WRITE_SECONDS=10
RETRY_WRITE=0
TIMEOUT_CHAT_START_SECONDS=15
TIMEOUT_CHAT_IDLE_SECONDS=30
TIMEOUT_CHAT_TOTAL_SECONDS=120
