# คัดลอกเป็น .env.local สำหรับรันในเครื่อง
# บน Vercel ให้ใส่ที่ Project Settings > Environment Variables แทน

# ── แชท AI (ไม่ใส่ก็ใช้งานได้) ─────────────────────────────────
# ไม่ใส่ = โหมดอ้างอิงเอกสารตรง ๆ ตอบจากข้อความในเอกสาร ไม่มีวันมั่ว
# ใส่แล้ว = คำตอบเป็นธรรมชาติขึ้น โดยยังอ้างอิงเอกสารเหมือนเดิม
# ขอคีย์ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── สำหรับรันในเครื่องเท่านั้น ─────────────────────────────────
# ชี้ให้ Next.js ส่ง /api/* ไปที่เซิร์ฟเวอร์ Python ที่รันแยก
# บน Vercel ไม่ต้องตั้ง เพราะ api/*.py เป็น serverless function อยู่แล้ว
PY_DEV_URL=http://127.0.0.1:8009
