{
  "name": "campusmate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/test-entry.ts --bundle --platform=node --format=esm --define:import.meta.env.VITE_USE_MOCKS=true --outfile=.test-build/tests.mjs && node .test-build/tests.mjs",
    "gen:api": "openapi-typescript contracts/real-openapi.json -o src/api/schema.d.ts",
    "gen:demo-api": "openapi-typescript contracts/demo-openapi.json -o src/api/schema.d.ts",
    "format": "prettier --write src scripts vite.config.ts",
    "preview:local": "node scripts/serve-preview.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "msw": "^2.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.12",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
