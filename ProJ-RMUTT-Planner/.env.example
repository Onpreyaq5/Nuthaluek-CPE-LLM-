# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  ->  cp .env.example .env
# !! ห้าม commit ไฟล์ .env ขึ้น GitHub เด็ดขาด !!

# --- Database ---
POSTGRES_USER=rmutt
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=rmutt_planner

# --- Auth ---
JWT_SECRET=change_me_random_64_chars

# โทเคนที่โมดูลคุยกันเอง (ใช้กับ endpoint ฝั่งแอดมินของ 08)
# ถ้าเว้นว่าง 08 จะตอบ 503 INTERNAL_AUTH_UNCONFIGURED
INTERNAL_API_TOKEN=change_me_internal_token

# --- โหมด adapter ของโมดูล 02 ---
# http = คุยกับโมดูลจริง (ค่าที่ควรใช้)
# mock = ใช้ข้อมูลปลอมในตัว 02 เอง (ใช้ตอนโมดูลปลายทางยังไม่เสร็จ)
ADAPTER_04=http
ADAPTER_05=http
ADAPTER_06=http
ADAPTER_07=http
ADAPTER_08=http

# --- LLM (เลือกอันเดียว) ---
# ถ้าใช้ Gemini ใส่คีย์ที่ GEMINI_API_KEY ด้านล่างที่เดียวพอ 03/07/09 อ่านจากตัวนั้นได้เลย
# LLM_API_KEY ใช้เมื่อเลือก provider อื่น (openai / anthropic / groq)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Local AI Model (Ollama ในเครื่อง) ---
# ดึงให้อัตโนมัติตอน docker compose up ครั้งแรก ไม่ต้องมีคีย์ ไม่ต้องมี GPU
# ใช้จัดประเภทคำถาม และตอบคำถามทั่วไปเมื่อไม่มีคีย์ Gemini (ไม่ใช้ตอบเรื่องระเบียบ)
LOCAL_MODEL=qwen2.5:0.5b

# --- บัญชีเดโมของหน้าเว็บ 01 (admin / admin1234) ---
# ปิด (false) ก่อนเปิดระบบให้คนนอกเข้าถึง
SEED_DEMO=true

# --- เวลารอคำตอบในแชตของ 02 (วินาที) ---
# โมเดลในเครื่องบน CPU ช้า ถ้าตั้งสั้นเกินแชตจะตัดก่อนได้คำตอบ
TIMEOUT_CHAT_IDLE_SECONDS=120
TIMEOUT_CHAT_TOTAL_SECONDS=180

# --- RAG ---
EMBED_MODEL=BAAI/bge-m3

# --- Data sync ---
SYNC_CRON=0 3 * * *

# --- Misc ---
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin

# เกณฑ์คะแนนค้นคืนขั้นต่ำของ 07 ต่ำกว่านี้ถือว่าไม่พบข้อมูล (ดู 07_rag_llm_engine/src/core/text.py)
MIN_SCORE=0.21

# ---------- 09 Main App ----------
# ใส่คีย์แล้วหน้าแชตจะเรียบเรียงคำตอบด้วย Gemini ไม่ใส่ก็ใช้ได้
# ระบบจะยกข้อความจากเอกสารที่ค้นเจอมาตอบตรง ๆ แทน ซึ่งไม่มีทางแต่งเติมเกินเอกสาร
# ขอคีย์ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# โดเมนที่เรียก API ของ 09 ได้ คั่นด้วยจุลภาค เว้นว่าง = เปิดให้ทุกโดเมน
# ถ้าเปิด API ออกอินเทอร์เน็ตพร้อมใส่คีย์ไว้ ต้องตั้งค่านี้เสมอ
# ไม่งั้นใครก็เอา URL ไปยิงเผาโควตาของเจ้าของคีย์ได้
ALLOWED_ORIGINS=
