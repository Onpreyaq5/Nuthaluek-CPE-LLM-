# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  ->  cp .env.example .env
# !! ห้าม commit ไฟล์ .env ขึ้น GitHub เด็ดขาด !!

# --- Database ---
POSTGRES_USER=rmutt
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=rmutt_planner

# --- Auth ---
JWT_SECRET=change_me_random_64_chars

# --- LLM (เลือกอันเดียว) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- RAG ---
EMBED_MODEL=BAAI/bge-m3

# --- Data sync ---
SYNC_CRON=0 3 * * *

# --- Misc ---
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin
